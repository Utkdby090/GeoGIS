  "photos": [
    { "slot": "LOCATION", "caption": "Location" },
    { "slot": "THERMAL", "caption": "Thermal Image" },
    { "slot": "STRUCTURE", "caption": "Tower Image" },
    { "slot": "RGB_ZOOM", "caption": "RGB Image" }
