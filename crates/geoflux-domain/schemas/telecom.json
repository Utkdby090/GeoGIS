{
  "schemaVersion": 2,
  "id": "com.geo.telecom",
  "name": "Electric Grid Inspection",
  "version": "1.0.0",
  "description": "Process 765kV transmission lines, mid-spans, and hardware fittings.",
  "labelField": "towerNumber",
  "fields": [
    { "key": "lineName", "label": "Line Name", "type": "text", "required": true, "group": "Location & Temporal Data", "row": 0 },
    { "key": "towerNumber", "label": "Tower No", "type": "text", "required": true, "group": "Location & Temporal Data", "row": 0, "weight": 0.5 },
    { "key": "circuit", "label": "Circuit", "type": "text", "group": "Location & Temporal Data", "row": 0, "weight": 0.5 },
    { "key": "phase", "label": "Phase", "type": "text", "group": "Location & Temporal Data", "row": 1 },
    { "key": "side", "label": "Side", "type": "text", "group": "Location & Temporal Data", "row": 1 },
    { "key": "direction", "label": "Direction", "type": "text", "group": "Location & Temporal Data", "row": 1 },
    { "key": "capturedDate", "label": "Captured Date", "type": "text", "group": "Location & Temporal Data", "row": 2 },
    { "key": "capturedTime", "label": "Captured Time", "type": "text", "group": "Location & Temporal Data", "row": 2 },
    { "key": "core.latitude", "label": "Latitude", "type": "number", "required": true, "group": "Location & Temporal Data", "row": 2 },
    { "key": "core.longitude", "label": "Longitude", "type": "number", "required": true, "group": "Location & Temporal Data", "row": 2 },
    { "key": "humidity", "label": "Humidity (%)", "type": "text", "group": "Environmental & Load Data", "row": 0 },
    { "key": "emissivity", "label": "Emissivity", "type": "text", "group": "Environmental & Load Data", "row": 0 },
    { "key": "ambientTemp", "label": "Amb. Temp (°C)", "type": "text", "group": "Environmental & Load Data", "row": 0 },
    { "key": "faultDescription", "label": "Fault Description", "type": "text", "group": "Fault Analysis", "row": 0 },
    { "key": "faultTemp", "label": "Fault Temp (°C)", "type": "text", "group": "Fault Analysis", "row": 1 },
    { "key": "riseTemp", "label": "Rise Temp (°C)", "type": "text", "group": "Fault Analysis", "row": 1 }
  ],
  "imageSlots": [
    { "id": "LOCATION", "label": "Location", "matches": ["location", "v"], "fallback": true },
    { "id": "THERMAL", "label": "Thermal Image", "thermal": true, "matches": ["thermal", "ir", "radiometric", "t"] },
    { "id": "STRUCTURE", "label": "Structure Image", "matches": ["tower", "structure", "wide", "w", "span", "mid", "midspan", "sleeve", "repair", "earth", "joint"] },
    { "id": "RGB_ZOOM", "label": "RGB Image", "matches": ["zoom", "rgb", "visual", "supp", "z"] }
  ],
  "csv": {
    "columns": [
      { "header": "Tower No.", "key": "towerNumber" },
      { "header": "Line Name", "key": "lineName" },
      { "header": "CKT", "key": "circuit" },
      { "header": "Phase", "key": "phase" },
      { "header": "Side", "key": "side" },
      { "header": "Captured Date", "key": "capturedDate" },
      { "header": "Captured Time", "key": "capturedTime" },
      { "header": "Ambeint Temp.", "key": "ambientTemp" },
      { "header": "Humidity", "key": "humidity" },
      { "header": "Emissivity", "key": "emissivity" },
      { "header": "Fault Temp.", "key": "faultTemp" },
      { "header": "Rise Temp.", "key": "riseTemp" },
      { "header": "Fault Description", "key": "faultDescription" },
      { "header": "Company Name", "key": "companyName" },
      { "header": "Direction", "key": "direction" },
      { "header": "report_Type", "key": "reportType", "default": "tower" },
      { "header": "Fault", "key": "faultStatus", "default": "normal" }
    ],
    "required": ["towerNumber", "lineName"],
    "latitude": "Lat.",
    "longitude": "Long.",
    "ignore": ["Sr. No."],
    "extraPrefix": "load.",
    "extraGroup": "Environmental & Load Data"
  },
  "severity": {
    "rise": "riseTemp",
    "measured": "faultTemp",
    "reference": "ambientTemp",
    "flaggedWhen": [
      { "key": "faultStatus", "contains": "fault" },
      { "key": "reportType", "contains": "fault" }
    ],
    "thresholds": { "low": 1.0, "medium": 4.0, "high": 16.0, "critical": 40.0 }
  },
  "defects": [
    { "id": "hotspot.joint", "label": "Hot joint or connector", "severity": "medium", "slots": ["THERMAL"] },
    { "id": "hotspot.clamp", "label": "Hot clamp or fitting", "severity": "medium", "slots": ["THERMAL"] },
    { "id": "hotspot.conductor", "label": "Hot conductor", "severity": "medium", "slots": ["THERMAL"] },
    { "id": "hotspot.insulator", "label": "Hot insulator", "severity": "medium", "slots": ["THERMAL"] },
    { "id": "hotspot.other", "label": "Other hot spot", "severity": "low", "slots": ["THERMAL"] },
    { "id": "insulator.broken_disc", "label": "Broken or missing insulator disc", "severity": "high" },
    { "id": "insulator.flashover", "label": "Flashover marks on insulator", "severity": "medium" },
    { "id": "insulator.contamination", "label": "Insulator contamination", "severity": "low" },
    { "id": "conductor.strand_damage", "label": "Damaged conductor strands", "severity": "high" },
    { "id": "conductor.damper", "label": "Damaged or slipped vibration damper", "severity": "medium" },
    { "id": "hardware.corrosion", "label": "Corroded hardware", "severity": "low" },
    { "id": "hardware.missing_pin", "label": "Missing or loose bolt, nut or pin", "severity": "medium" },
    { "id": "tower.missing_member", "label": "Missing tower member", "severity": "high" },
    { "id": "tower.bent_member", "label": "Bent tower member", "severity": "medium" },
    { "id": "tower.missing_plate", "label": "Missing number or danger plate", "severity": "low" },
    { "id": "earthing.damaged", "label": "Damaged or missing earthing", "severity": "medium" },
    { "id": "bird_nest", "label": "Bird nest", "severity": "low" },
    { "id": "vegetation", "label": "Vegetation near conductors", "severity": "medium" },
    { "id": "other", "label": "Other defect", "severity": "low" }
  ],
  "findingFields": [
    { "key": "faultDescription", "from": "defects" },
    { "key": "faultTemp", "from": "max", "measure": "maxC" },
    { "key": "riseTemp", "from": "max", "measure": "riseC" }
  ]
}
