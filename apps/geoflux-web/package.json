{
  "name": "geoflux-web",
  "private": true,
  "version": "0.2.0",
  "description": "GeoFlux web app: surveys on a map, towers with photos and markup, reports. Built into geoflux-server.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "tsc --noEmit && tsc --noEmit -p e2e && vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@tanstack/react-query": "5.104.1",
    "echarts": "6.1.0",
    "maplibre-gl": "6.13.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-grid-layout": "2.3.0",
    "react-router": "8.4.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "29.1.1",
    "typescript": "6.0.3",
    "vite": "7.3.7",
    "vitest": "4.1.10"
  }
}
