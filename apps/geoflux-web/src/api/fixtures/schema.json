  "labelField": "towerNumber",
  "name": "Electric Grid Inspection",
  "schemaVersion": 1,
  "severity": {
    "flaggedWhen": [
      {
        "contains": "fault",
        "key": "faultStatus"
      },
      {
        "contains": "fault",
        "key": "reportType"
      }
    ],
    "measured": "faultTemp",
    "reference": "ambientTemp",
    "rise": "riseTemp",
    "thresholds": {
      "critical": 40.0,
      "high": 16.0,
      "low": 1.0,
      "medium": 4.0
