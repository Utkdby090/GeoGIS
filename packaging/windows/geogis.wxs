<?xml version="1.0" encoding="utf-8"?>
<!--
  Windows Installer package (WiX 5), built by package.sh. An all-users install in Program Files:
  a Start menu shortcut, rustgis-cli on the system PATH, .rgis/.rgisx projects opened by GeoGIS
  and GeoGIS offered under Open with for .geojson. Variables passed with -d: Version (three
  numbers), Publisher, Stage (the folder holding the exes, LICENSE and NOTICE), Icon, License (RTF),
  Banner and Dialog (BMPs).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <!-- The UpgradeCode never changes: a new version replaces the installed one. It is GeoGIS's
    own (not RustGIS's), so installing GeoGIS never removes RustGIS from the same computer. -->
  <Package Name="GeoGIS" Manufacturer="$(var.Publisher)" Version="$(var.Version)"
    UpgradeCode="C3E5BAC9-A7DC-4057-9298-9042A6BEA2C2" Scope="perMachine" Language="1033">
    <!-- Same-version upgrades too: a pre-release (0.2.0-rc.1) and its release share 0.2.0. -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
      DowngradeErrorMessage="A newer version of GeoGIS is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="geogis.ico" SourceFile="$(var.Icon)" />
    <Property Id="ARPPRODUCTICON" Value="geogis.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/Utkdby090/GeoGIS" />
    <Property Id="ARPHELPLINK" Value="https://github.com/Utkdby090/GeoGIS/issues" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="GeoGIS" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="GeoGIS">
      <Component Directory="INSTALLFOLDER">
        <File Id="geogis.exe" Source="$(var.Stage)\geogis.exe" KeyPath="yes" />
        <ProgId Id="GeoGIS.Project" Description="GeoGIS project" Icon="geogis.exe" IconIndex="0">
          <Extension Id="rgis">
            <Verb Id="open" TargetFile="geogis.exe" Argument="&quot;%1&quot;" />
          </Extension>
          <!-- The verb is the ProgId's (GeoGIS.Project\shell\open): one serves both. -->
          <Extension Id="rgisx" />
        </ProgId>
        <!-- Listed under Open with for GeoJSON, without taking over the default app. -->
        <RegistryValue Root="HKLM" Key="Software\Classes\.geojson\OpenWithProgids" Name="GeoGIS.Project"
          Type="string" Value="" />
      </Component>
      <Component Directory="INSTALLFOLDER">
        <File Id="rustgis_cli.exe" Source="$(var.Stage)\rustgis-cli.exe" KeyPath="yes" />
        <Environment Id="PathEntry" Name="PATH" Value="[INSTALLFOLDER]" Part="last" Action="set"
          System="yes" Permanent="no" />
      </Component>
      <!-- A shortcut needs a registry key path (ICE43). -->
      <Component Id="StartMenuShortcut" Directory="ProgramMenuFolder">
        <Shortcut Id="StartMenuShortcut" Name="GeoGIS" Description="Desktop GIS for power-line inspection"
          Target="[#geogis.exe]" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\GeoGIS" Name="StartMenuShortcut" Type="integer" Value="1"
          KeyPath="yes" />
      </Component>
      <Component Directory="INSTALLFOLDER">
        <File Id="LICENSE" Source="$(var.Stage)\LICENSE" Name="LICENSE.txt" KeyPath="yes" />
      </Component>
      <Component Directory="INSTALLFOLDER">
        <File Id="NOTICE" Source="$(var.Stage)\NOTICE" Name="NOTICE.txt" KeyPath="yes" />
      </Component>
    </Feature>

    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.License)" />
    <WixVariable Id="WixUIBannerBmp" Value="$(var.Banner)" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.Dialog)" />
  </Package>
</Wix>
