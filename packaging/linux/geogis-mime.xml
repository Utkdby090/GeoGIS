<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-geogis-project">
    <comment>GeoGIS project</comment>
    <sub-class-of type="application/json"/>
    <glob pattern="*.rgis"/>
    <glob pattern="*.rgisx"/>
  </mime-type>
  <mime-type type="application/x-geoflux-project">
    <comment>GeoFlux project</comment>
    <sub-class-of type="application/zip"/>
    <glob pattern="*.geox"/>
  </mime-type>
</mime-info>
